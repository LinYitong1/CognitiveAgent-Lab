+# ---------------------------------------------------------------------------
+# G-2 退回补测（qa-M1.md §三）：chunked / EOF / 畸形响应 / URL 错误 / 连接异常 / 超时
+# ---------------------------------------------------------------------------
+
+
+def _chunked_payload(chunks: list[bytes]) -> bytes:
+    """构造 chunked 编码的响应体字节流。"""
+    return b"".join(b"%x\r\n%s\r\n" % (len(chunk), chunk) for chunk in chunks) + b"0\r\n\r\n"
+
+
+@pytest.mark.asyncio
