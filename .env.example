# CognitiveAgent Lab configuration template (copy to .env; .env is gitignored)
# CALC_AGENT_ENV_FILE: override for the pydantic-settings env_file path (see ARCHITECTURE §7; set to /dev/null to bypass .env)
CALC_AGENT_ENV_FILE=.env

# LLM provider credentials (either one; M0 does not check presence, may stay empty)
# OPENAI_API_KEY is required for the default OpenAI endpoint and any endpoint
# that requires authentication.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM endpoint: any OpenAI-compatible provider works (OpenAI, Ollama, LM Studio,
# vLLM, OpenRouter, ...). For a keyless local endpoint (e.g. a local Ollama at
# http://localhost:11434/v1) leave OPENAI_API_KEY empty — a documented
# placeholder key is used automatically; for endpoints that require
# authentication, set OPENAI_API_KEY as well.
LLM_BASE_URL=
LLM_MODEL=gpt-4o

# Agent main-loop step limit
CALC_AGENT_MAX_STEPS=25

# http_request host allow-list (comma-separated, defaults to example.com)
HTTP_ALLOWED_HOSTS=example.com

# file_write sandbox root (also the default --output directory of the CLI)
DATA_SANDBOX_DIR=data
