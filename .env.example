# CognitiveAgent Lab 配置模板（复制为 .env 使用；.env 已被 gitignore）
# CALC_AGENT_ENV_FILE: pydantic-settings env_file 路径覆盖（见 ARCHITECTURE §7；设为 /dev/null 即绕开 .env）
CALC_AGENT_ENV_FILE=.env

# LLM 密钥（二选一；M0 不校验存在性，可留空）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM 端点（可选，兼容端点；留空使用官方默认）
LLM_BASE_URL=
LLM_MODEL=gpt-4o

# Agent 主循环步数上限
CALC_AGENT_MAX_STEPS=25

# http_request 域名白名单（逗号分隔，默认含 example.com）
HTTP_ALLOWED_HOSTS=example.com

# file_write 沙箱根目录
DATA_SANDBOX_DIR=data
